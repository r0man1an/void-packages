kkk# Template file for 'selinux-refpolicy'
pkgname=selinux-refpolicy
version=2.20260616
revision=3
short_desc="SELinux reference policy (Void, runit) - work in progress"
maintainer="You <you@example.com>"
license="GPL-2.0-only"
homepage="https://github.com/SELinuxProject/refpolicy"
distfiles="https://github.com/SELinuxProject/refpolicy/releases/download/RELEASE_2_${version#*.}/refpolicy-${version}.tar.bz2"
checksum=2d7e01b0ae265c6f5e86a7e2ede0b9061ac1ca8085051f0326770b5b955ba756
hostmakedepends="checkpolicy policycoreutils m4 python3 secilc semodule-utils gawk"
makedepends="libsepol-devel libselinux-devel libsemanage-devel"
depends="policycoreutils checkpolicy libsemanage semodule-utils secilc"
noshlibprovides=yes
nostrip=yes

_selinuxtype="refpolicy"

do_build() {
	make SELINUX_MAKEFILES=./support conf
	sed -i \
		-e 's/^TYPE = .*/TYPE = standard/' \
		-e 's/^NAME = .*/NAME = refpolicy/' \
		-e 's/^#\?\s*DISTRO = .*/DISTRO = gentoo/' \
		-e 's/^MONOLITHIC = .*/MONOLITHIC = n/' \
		-e 's/^UNK_PERMS = .*/UNK_PERMS = allow/' \
		-e 's/^DIRECT_INITRC = .*/DIRECT_INITRC = y/' \
		-e 's/^SYSTEMD = .*/SYSTEMD = n/' \
		build.conf
	make base modules
}

do_install() {
	make DESTDIR="${DESTDIR}" install install-headers
	make DESTDIR="${DESTDIR}" install-src

	local _fc
	_fc="$(find . -type f -name file_contexts ! -path '*subs*' -size +0c 2>/dev/null | head -1)"
	if [ -z "$_fc" ]; then
		cat tmp/*.mod.fc > tmp/file_contexts 2>/dev/null
		_fc="tmp/file_contexts"
	fi
	if [ ! -s "$_fc" ]; then
		msg_error "file_contexts was not generated by the build\n"
	fi
	install -Dm644 "$_fc" \
		"${DESTDIR}/etc/selinux/${_selinuxtype}/contexts/files/file_contexts"

	for f in file_contexts.homedirs file_contexts.subs_dist media; do
		_found="$(find . -type f -name "$f" -size +0c 2>/dev/null | head -1)"
		[ -n "$_found" ] && install -Dm644 "$_found" \
			"${DESTDIR}/etc/selinux/${_selinuxtype}/contexts/files/$f"
	done

	vmkdir etc/selinux
	cat > "${DESTDIR}/etc/selinux/config" <<-EOF
		# SELINUX= disabled | permissive | enforcing
		SELINUX=permissive
		SELINUXTYPE=${_selinuxtype}
	EOF
}
